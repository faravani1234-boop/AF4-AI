# Set secrets only in your hosting provider's environment settings.
# The router chooses providers by task type and falls back automatically.
AI_PROVIDER_PRIORITY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
PORT=3000

# Instagram agent (set secrets only in Render Environment; never commit real values)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_AGENT_ADMIN_TOKEN=
INSTAGRAM_AGENT_MODE=approval
